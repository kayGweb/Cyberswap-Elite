      target_content: "  if (profile?.isKycVerified || success) {\n    return (\n      <div className=\"max-w-md mx-auto p-12 border border-green-500/20 bg-green-50 rounded-2xl text-center space-y-6\">\n        <div className=\"w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto\">\n          <CheckCircle2 className=\"w-10 h-10\" />\n        </div>\n        <div className=\"space-y-2\">\n          <h2 className=\"text-xl font-black uppercase tracking-tight\">Identity Verified</h2>\n          <p className=\"text-sm text-green-700/70 font-medium\">Your account is now ready for high-volume swaps.</p>\n        </div>\n        <div className=\"p-4 bg-white/50 rounded-lg border border-green-200\">\n          <div className=\"flex justify-between text-[10px] font-bold uppercase tracking-[0.2em] text-green-800/40\">\n            <span>Level</span>\n            <span className=\"text-green-600\">Full Access</span>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-xl mx-auto py-8\">\n      <div className=\"bg-black text-white p-8 rounded-t-2xl space-y-2\">\n        <div className=\"flex items-center gap-2 text-xs font-black uppercase tracking-[0.3em] text-white/50\">\n          <Shield className=\"w-4 h-4\" /> Security Proof\n        </div>\n        <h2 className=\"text-2xl font-black uppercase tracking-tight\">Basic KYC Verification</h2>\n        <p className=\"text-sm text-white/60 font-medium\">Complete this process to unlock full exchange features.</p>\n      </div>\n\n      <form onSubmit={handleSubmit} className=\"p-8 border-x border-b border-black rounded-b-2xl bg-white space-y-6\">\n        <div className=\"grid grid-cols-2 gap-6\">\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-400\">Full Legal Name</label>\n            <input \n              required\n              type=\"text\"\n           