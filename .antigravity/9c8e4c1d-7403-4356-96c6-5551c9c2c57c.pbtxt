  file_change {
    absolute_path_uri: "file:///firestore.rules"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "rules_version = \'2\';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // 1. Global Safety Net\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // --- Helpers ---\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    // --- Entity Validations ---\n\n    function isValidUserProfile(data) {\n      return data.userId == request.auth.uid &&\n             data.fullName is string && data.fullName.size() <= 100 &&\n             data.isKycVerified is bool &&\n             (data.keys().hasAll([\'userId\', \'fullName\', \'isKycVerified\']) && data.keys().size() >= 3);\n    }\n\n    function isValidTransaction(data) {\n      return data.userId == request.auth.uid &&\n             data.fromCurrency is string && data.fromCurrency.size() <= 10 &&\n             data.toCurrency is string && data.toCurrency.size() <= 10 &&\n             data.amountFrom is string && data.amountFrom.size() <= 32 &&\n             data.status is string && data.status.size() <= 20 &&\n             data.changellyId is string && data.changellyId.size() <= 64 &&\n             data.createdAt == request.time;\n    }\n\n    // --- Match Groups ---\n\n    match /users/{userId} {\n      allow get: if isOwner(userId);\n      allow create: if isOwner(userId) && isValidUserProfile(incoming());\n      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && (\n        // Action: Update Profile/KYC\n        incoming().diff(existing()).affectedKeys().hasOnly([\'fullName\', \'dateOfBirth\', \'documentType\', \'documentNumber\', \'favoriteCoins\', \'isKycVerified\', \'updatedAt\'])\n      );\n    }\n\n    match /users/{userId}/transactions/{transactionId} {\n      allow list: if isOwner(userId);\n      allow get: if isOwner(userId);\n      allow create: if isOwner(userId) && isValidTransaction(incoming());\n      allow update: if isOwner(userId) && (\n        // Terminal state locking: status\n        (existing().status != \'finished\' && existing().status != \'failed\') &&\n        isValidTransaction(incoming()) &&\n        incoming().diff(existing()).affectedKeys().hasOnly([\'status\', \'amountTo\', \'payinAddress\'])\n      );\n    }\n  }\n}\n"
    }
