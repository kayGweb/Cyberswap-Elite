      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHIqgHIasMyAY2RUpqMRIRpFBq7rAXhCBX3jO9vQd3gnbrN-8q9V0rePCAxIogNbHnF-VESFDqFZNHceo1MCNVde0nuzreaXFH8DfvMH7NviaY4I9Ce09APmg=="
