  file_change {
    absolute_path_uri: "file:///src/components/Navigation.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { LogIn, LogOut, History, Wallet, User as UserIcon } from \'lucide-react\';\nimport { useAuth } from \'./FirebaseProvider\';\nimport { signInWithGoogle, auth } from \'../lib/firebase\';\nimport { motion } from \'motion/react\';\n\ninterface NavigationProps {\n  activeTab: \'swap\' | \'history\' | \'kyc\' | \'favorites\';\n  setActiveTab: (tab: \'swap\' | \'history\' | \'kyc\' | \'favorites\') => void;\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({ activeTab, setActiveTab }) => {\n  const { user, profile } = useAuth();\n\n  return (\n    <nav className=\"border-b border-black/10 bg-white/80 backdrop-blur-md sticky top-0 z-50\">\n      <div className=\"max-w-7xl mx-auto px-4 h-16 flex items-center justify-between\">\n        <div className=\"flex items-center gap-8\">\n          <div className=\"flex items-center gap-2 font-black text-xl tracking-tighter\">\n            <div className=\"w-8 h-8 bg-black flex items-center justify-center text-white rounded\">\302\247</div>\n            CRYPTOSWAP\n          </div>\n          \n          <div className=\"hidden md:flex items-center gap-6\">\n            <NavButton \n              active={activeTab === \'swap\'} \n              onClick={() => setActiveTab(\'swap\')}\n              icon={<Wallet className=\"w-4 h-4\" />}\n              label=\"Swap\"\n            />\n            <NavButton \n              active={activeTab === \'history\'} \n              onClick={() => setActiveTab(\'history\')}\n              icon={<History className=\"w-4 h-4\" />}\n              label=\"History\"\n            />\n            <NavButton \n              active={activeTab === \'kyc\'} \n              onClick={() => setActiveTab(\'kyc\')}\n              icon={<UserIcon className=\"w-4 h-4\" />}\n              label={profile?.isKycVerified ? \"Verified\" : \"KYC\"}\n            />\n             <NavButton \n              active={activeTab === \'favorites\'} \n              onClick={() => setActiveTab(\'favorites\')}\n              icon={<UserIcon className=\"w-4 h-4\" />}\n              label=\"Favorites\"\n            />\n          </div>\n        </div>\n\n        <div>\n          {user ? (\n            <div className=\"flex items-center gap-4\">\n              <span className=\"text-xs font-mono text-gray-500 hidden sm:inline\">{user.email}</span>\n              <button \n                onClick={() => auth.signOut()}\n                className=\"flex items-center gap-2 text-xs font-bold uppercase tracking-widest hover:text-red-500 transition-colors\"\n              >\n                <LogOut className=\"w-4 h-4\" /> Sign Out\n              </button>\n            </div>\n          ) : (\n            <button \n              onClick={signInWithGoogle}\n              className=\"flex items-center gap-2 bg-black text-white px-4 py-2 rounded text-xs font-bold uppercase tracking-widest hover:bg-gray-800 transition-all active:scale-95\"\n            >\n              <LogIn className=\"w-4 h-4\" /> Sign In\n            </button>\n          )}\n        </div>\n      </div>\n    </nav>\n  );\n};\n\nconst NavButton = ({ active, onClick, icon, label }: { active: boolean; onClick: () => void; icon: React.ReactNode; label: string }) => (\n  <button \n    onClick={onClick}\n    className={`flex items-center gap-2 text-xs font-bold uppercase tracking-widest transition-all relative py-2 ${\n      active ? \'text-black\' : \'text-gray-400 hover:text-black\'\n    }`}\n  >\n    {icon}\n    {label}\n    {active && (\n      <motion.div \n        layoutId=\"nav-underline\"\n        className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-black\"\n      />\n    )}\n  </button>\n);\n"
      replacement_content: "import React from \'react\';\nimport { LogIn, LogOut, History, Wallet, User as UserIcon, ShieldCheck, Star } from \'lucide-react\';\nimport { useAuth } from \'./FirebaseProvider\';\nimport { signInWithGoogle, auth } from \'../lib/firebase\';\nimport { motion } from \'motion/react\';\n\ninterface NavigationProps {\n  activeTab: \'swap\' | \'history\' | \'kyc\' | \'favorites\';\n  setActiveTab: (tab: \'swap\' | \'history\' | \'kyc\' | \'favorites\') => void;\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({ activeTab, setActiveTab }) => {\n  const { user, profile } = useAuth();\n\n  return (\n    <nav className=\"w-64 bg-[#121212] border-r border-gray-800 flex flex-col h-screen sticky top-0\">\n      <div className=\"p-8\">\n        <div className=\"flex items-center space-x-3 mb-12\">\n          <div className=\"w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center font-bold text-white italic\">C</div>\n          <span className=\"text-xl font-bold tracking-tight uppercase text-white\">CryptoSwap</span>\n        </div>\n        \n        <div className=\"space-y-4\">\n          <NavButton \n            active={activeTab === \'swap\'} \n            onClick={() => setActiveTab(\'swap\')}\n            icon={<Wallet className=\"w-5 h-5\" />}\n            label=\"Exchange\"\n          />\n          <NavButton \n            active={activeTab === \'history\'} \n            onClick={() => setActiveTab(\'history\')}\n            icon={<History className=\"w-5 h-5\" />}\n            label=\"History\"\n          />\n          <NavButton \n            active={activeTab === \'kyc\'} \n            onClick={() => setActiveTab(\'kyc\')}\n            icon={<ShieldCheck className=\"w-5 h-5\" />}\n            label=\"Verification\"\n          />\n           <NavButton \n            active={activeTab === \'favorites\'} \n            onClick={() => setActiveTab(\'favorites\')}\n            icon={<Star className=\"w-5 h-5\" />}\n            label=\"Favorites\"\n          />\n        </div>\n      </div>\n\n      <div className=\"mt-auto p-8 border-t border-gray-800\">\n        {user ? (\n          <div className=\"space-y-4\">\n            <div className=\"bg-indigo-900/20 border border-indigo-500/30 rounded-xl p-4\">\n              <p className=\"text-[10px] text-indigo-300 uppercase font-bold mb-1\">Account</p>\n              <p className=\"text-xs text-gray-100 font-semibold truncate\">{user.email}</p>\n              <div className=\"w-full bg-gray-800 h-1 mt-2 rounded-full overflow-hidden\">\n                <div className={`bg-indigo-500 h-1 rounded-full ${profile?.isKycVerified ? \'w-full\' : \'w-1/3\'}`}></div>\n              </div>\n              <p className=\"text-[8px] text-gray-500 mt-1 uppercase font-bold\">\n                {profile?.isKycVerified ? \"Fully Verified\" : \"Basic Access\"}\n              </p>\n            </div>\n            <button \n              onClick={() => auth.signOut()}\n              className=\"w-full flex items-center justify-center gap-2 py-3 border border-gray-800 rounded-xl text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-red-400 hover:border-red-400/30 transition-all\"\n            >\n              <LogOut className=\"w-4 h-4\" /> Sign Out\n            </button>\n          </div>\n        ) : (\n          <button \n            onClick={signInWithGoogle}\n            className=\"w-full flex items-center justify-center gap-2 bg-indigo-600 text-white py-3 rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-indigo-500 transition-all active:scale-95\"\n          >\n            <LogIn className=\"w-4 h-4\" /> Sign In\n          </button>\n        )}\n      </div>\n    </nav>\n  );\n};\n\nconst NavButton = ({ active, onClick, icon, label }: { active: boolean; onClick: () => void; icon: React.ReactNode; label: string }) => (\n  <button \n    onClick={onClick}\n    className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all group ${\n      active \n        ? \'bg-indigo-600/10 text-indigo-400 border border-indigo-500/20\' \n        : \'text-gray-500 hover:text-gray-300 hover:bg-gray-800/50\'\n    }`}\n  >\n    <span className={`${active ? \'text-indigo-400\' : \'text-gray-600 group-hover:text-gray-400\'}`}>\n      {icon}\n    </span>\n    {label}\n  </button>\n);\n"
    }
