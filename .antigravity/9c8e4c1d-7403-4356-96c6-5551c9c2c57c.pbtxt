none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\\\"></path></svg>\\n          <span>Favorites</span>\\n        </li>\\n      </ul>\\n    </div>\\n    <div class=\\\"mt-auto p-8 border-t border-gray-800\\\">\\n      <div class=\\\"bg-indigo-900/20 border border-indigo-500/30 rounded-xl p-4\\\">\\n        <p class=\\\"text-xs text-indigo-300 uppercase font-bold mb-1\\\">KYC Status</p>\\n        <p class=\\\"text-sm text-gray-100 font-semibold\\\">Level 1 Verified</p>\\n        <div class=\\\"w-full bg-gray-800 h-1 mt-2 rounded-full\\\">\\n          <div class=\\\"bg-indigo-500 h-1 w-1/3 rounded-full\\\"></div>\\n        </div>\\n      </div>\\n    </div>\\n  </nav>\\n\\n  <!-- Main Content -->\\n  <main class=\\\"flex-1 flex flex-col\\\">\\n    <!-- Header -->\\n    <header class=\\\"h-20 border-b border-gray-800 flex items-center justify-between px-10 bg-[#0E0E0E]\\\">\\n      <div>\\n        <h1 class=\\\"text-lg font-semibold\\\">Quick Exchange</h1>\\n        <p class=\\\"text-xs text-gray-500\\\">Powered by Changelly API v2.1</p>\\n      </div>\\n      <div class=\\\"flex items-center space-x-6\\\">\\n        <div class=\\\"text-right\\\">\\n          <p class=\\\"text-xs text-gray-500 uppercase tracking-widest\\\">Wallet Balance</p>\\n          <p class=\\\"text-sm font-mono\\\">1.4285 BTC</p>\\n        </div>\\n        <div class=\\\"w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center border border-gray-700\\\">\\n          <span class=\\\"text-xs font-bold\\\">JD</span>\\n        </div>\\n      </div>\\n    </header>\\n\\n    <!-- Page Layout -->\\n    <div class=\\\"flex-1 p-10 grid grid-cols-12 gap-8 overflow-hidden\\\">\\n      <!-- Exchange Section -->\\n      <div class=\\\"col-span-7 flex flex-col space-y-6\\\"