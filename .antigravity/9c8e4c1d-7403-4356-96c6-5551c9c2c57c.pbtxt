    replacement_chunks {
      target_content: "export const SwapInterface: React.FC = () => {\n  const { user, profile } = useAuth();\n  const [currencies, setCurrencies] = useState<ChangellyCurrency[]>([]);\n  const [fromCoin, setFromCoin] = useState(\'btc\');\n  const [toCoin, setToCoin] = useState(\'eth\');\n  const [amount, setAmount] = useState(\'0.1\');\n  const [estimate, setEstimate] = useState<string | null>(null);\n  const [loading, setLoading] = useState(false);\n  const [estimating, setEstimating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [address, setAddress] = useState(\'\');\n  const [txResult, setTxResult] = useState<any | null>(null);\n\n  useEffect(() => {\n    changellyService.getCurrencies()\n      .then(setCurrencies)\n      .catch(err => setError(err.message));\n  }, []);\n\n  useEffect(() => {\n    if (!fromCoin || !toCoin || !amount || isNaN(Number(amount)) || Number(amount) <= 0) {\n      setEstimate(null);\n      return;\n    }\n\n    const timer = setTimeout(() => {\n      setEstimating(true);\n      changellyService.getExchangeAmount(fromCoin, toCoin, amount)\n        .then(result => {\n          setEstimate(result[0].result);\n          setError(null);\n        })\n        .catch(err => {\n          setEstimate(null);\n          setError(err.message);\n        })\n        .finally(() => setEstimating(false));\n    }, 500);\n\n    return () => clearTimeout(timer);\n  }, [fromCoin, toCoin, amount]);\n\n  const handleSwap = async () => {\n    if (!user) return;\n    if (!profile?.isKycVerified) {\n      setError(\"Please complete KYC verification before swapping.\");\n      return;\n    }\n    if (!address) {\n      setError(\"Please enter a valid payout address.\");\n      return;\n    }\n\n    setLoading(true);\n    setError(null);\n    try {\n      const result = await changellyService.createTransaction(fromCoin, toCoin, amount, address);\n      \n      // Save to Firebase\n      await addDoc(collection(db, \'users\', user.uid, \'transactions\'), {\n        userId: user.uid,\n        fromCurrency: fromCoin,\n        toCurrency: toCoin,\n        amountFrom: amount,\n        amountTo: estimate,\n        status: \'pending\',\n        changellyId: result.id,\n        payoutAddress: address,\n        payinAddress: result.payinAddress,\n        createdAt: serverTimestamp(),\n      });\n\n      setTxResult(result);\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const flipCoins = () => {\n    const temp = fromCoin;\n    setFromCoin(toCoin);\n    setToCoin(temp);\n  };\n\n  if (txResult) {\n    return (\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        className=\"max-w-md mx-auto p-8 border border-black rounded-lg bg-white shadow-2xl space-y-6\"\n      >\n        <div className=\"flex justify-center\">\n          <div className=\"w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center\">\n            <CheckCircle2 className=\"w-10 h-10\" />\n          </div>\n        </div>\n        <div className=\"text-center space-y-2\">\n          <h2 className=\"text-xl font-black uppercase tracking-tight\">Transaction Created</h2>\n          <p className=\"text-sm text-gray-500\">Please send your funds to the address below.</p>\n        </div>\n\n        <div className=\"p-4 bg-gray-50 border border-black/5 rounded-md space-y-4\">\n          <div>\n            <label className=\"text-[10px] font-bold uppercase tracking-widest text-gray-400 block mb-1\">Pay-in Address ({fromCoin.toUpperCase()})</label>\n            <div className=\"font-mono text-xs break-all bg-white p-3 border border-black/10 rounded font-bold\">\n              {txResult.payinAddress}\n            </div>\n          </div>\n          <div className=\"flex justify-between text-xs font-bold uppercase tracking-wider\">\n            <span>Send Amount:</span>\n            <span>{amount} {fromCoin.toUpperCase()}</span>\n          </div>\n        </div>\n\n        <button \n          onClick={() => setTxResult(null)}\n          className=\"w-full py-4 bg-black text-white rounded text-xs font-black uppercase tracking-[0.2em] hover:bg-gray-800 transition-all active:scale-95\"\n        >\n          Back to Swap\n        </button>\n      </motion.div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-md mx-auto\">\n      <div className=\"p-8 border border-black rounded-2xl bg-white shadow-xl space-y-6 relative overflow-hidden\">\n        <div className=\"absolute top-0 left-0 w-full h-1 bg-black/5\" />\n        \n        <div className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <CurrencySelector \n              label=\"You Send\"\n              currencies={currencies}\n              selectedTicker={fromCoin}\n              onSelect={setFromCoin}\n            />\n            <div className=\"relative\">\n              <input \n                type=\"number\"\n                value={amount}\n                onChange={(e) => setAmount(e.target.value)}\n                className=\"w-full p-4 text-2xl font-black bg-gray-50 border border-black/5 rounded focus:border-black transition-colors outline-none\"\n                placeholder=\"0.00\"\n              />\n              <div className=\"absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-400 uppercase tracking-widest\">\n                {fromCoin}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex justify-center -my-3 relative z-10\">\n            <button \n              onClick={flipCoins}\n              className=\"p-2 bg-black text-white rounded-full hover:rotate-180 transition-all duration-500 active:scale-90 shadow-lg border-4 border-white\"\n            >\n              <ArrowUpDown className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-2\">\n            <CurrencySelector \n              label=\"You Receive\"\n              currencies={currencies}\n              selectedTicker={toCoin}\n              onSelect={setToCoin}\n            />\n            <div className=\"relative\">\n              <div className=\"w-full p-4 text-2xl font-black bg-gray-50 border border-black/5 rounded min-h-[64px] flex items-center\">\n                {estimating ? (\n                  <Loader2 className=\"w-5 h-5 animate-spin text-gray-300\" />\n                ) : (\n                  estimate || \"0.00\"\n                )}\n              </div>\n              <div className=\"absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-400 uppercase tracking-widest\">\n                {toCoin}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <label className=\"text-[10px] uppercase tracking-widest font-bold text-gray-400 mb-1 block\">\n              Recipient {toCoin.toUpperCase()} Address\n            </label>\n            <input \n              type=\"text\"\n              value={address}\n              onChange={(e) => setAddress(e.target.value)}\n              className=\"w-full p-3 text-sm font-mono border border-black/10 rounded focus:border-black transition-colors outline-none bg-gray-50\"\n              placeholder={`Enter ${toCoin.toUpperCase()} address`}\n            />\n          </div>\n        </div>\n\n        <AnimatePresence>\n          {error && (\n            <motion.div \n              initial={{ opacity: 0, height: 0 }}\n              animate={{ opacity: 1, height: \'auto\' }}\n              exit={{ opacity: 0, height: 0 }}\n              className=\"flex items-center gap-2 p-3 bg-red-50 text-red-600 rounded text-xs font-bold border border-red-100\"\n            >\n              <AlertCircle className=\"w-4 h-4 flex-shrink-0\" />\n              {error}\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        <button \n          disabled={loading || !estimate || !user}\n          onClick={handleSwap}\n          className=\"w-full py-5 bg-black text-white rounded font-black text-xs uppercase tracking-[0.25em] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-800 transition-all active:scale-95 shadow-xl disabled:active:scale-100\"\n        >\n          {loading ? (\n            <Loader2 className=\"w-5 h-5 animate-spin mx-auto\" />\n          ) : !user ? (\n            \"Login to Swap\"\n          ) : (\n            \"Exchange Now\"\n          )}\n        </button>\n\n        {!profile?.isKycVerified && user && (\n          <p className=\"text-[10px] text-center text-gray-400 uppercase tracking-widest font-bold\">\n            KYC Verification Required\n          </p>\n        )}\n      </div>\n    </div>\n  );\n};\n"
      replacement_content: "export const SwapInterface: React.FC = () => {\n  const { user, profile } = useAuth();\n  const [currencies, setCurrencies] = useState<ChangellyCurrency[]>([]);\n  const [fromCoin, setFromCoin] = useState(\'btc\');\n  const [toCoin, setToCoin] = useState(\'eth\');\n  const [amount, setAmount] = useState(\'0.1\');\n  const [estimate, setEstimate] = useState<string | null>(null);\n  const [loading, setLoading] = useState(false);\n  const [estimating, setEstimating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [address, setAddress] = useState(\'\');\n  const [txResult, setTxResult] = useState<any | null>(null);\n\n  useEffect(() => {\n    changellyService.getCurrencies()\n      .then(setCurrencies)\n      .catch(err => setError(err.message));\n  }, []);\n\n  useEffect(() => {\n    if (!fromCoin || !toCoin || !amount || isNaN(Number(amount)) || Number(amount) <= 0) {\n      setEstimate(null);\n      return;\n    }\n\n    const timer = setTimeout(() => {\n      setEstimating(true);\n      changellyService.getExchangeAmount(fromCoin, toCoin, amount)\n        .then(result => {\n          setEstimate(result[0].result);\n          setError(null);\n        })\n        .catch(err => {\n          setEstimate(null);\n          setError(err.message);\n        })\n        .finally(() => setEstimating(false));\n    }, 500);\n\n    return () => clearTimeout(timer);\n  }, [fromCoin, toCoin, amount]);\n\n  const handleSwap = async () => {\n    if (!user) return;\n    if (!profile?.isKycVerified) {\n      setError(\"Please complete KYC verification before swapping.\");\n      return;\n    }\n    if (!address) {\n      setError(\"Please enter a valid payout address.\");\n      return;\n    }\n\n    setLoading(true);\n    setError(null);\n    try {\n      const result = await changellyService.createTransaction(fromCoin, toCoin, amount, address);\n      \n      // Save to Firebase\n      await addDoc(collection(db, \'users\', user.uid, \'transactions\'), {\n        userId: user.uid,\n        fromCurrency: fromCoin,\n        toCurrency: toCoin,\n        amountFrom: amount,\n        amountTo: estimate,\n        status: \'pending\',\n        changellyId: result.id,\n        payoutAddress: address,\n        payinAddress: result.payinAddress,\n        createdAt: serverTimestamp(),\n      });\n\n      setTxResult(result);\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const flipCoins = () => {\n    const temp = fromCoin;\n    setFromCoin(toCoin);\n    setToCoin(temp);\n  };\n\n  if (txResult) {\n    return (\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        className=\"max-w-md mx-auto p-10 border border-gray-800 rounded-3xl bg-[#161616] shadow-2xl space-y-8\"\n      >\n        <div className=\"flex justify-center\">\n          <div className=\"w-20 h-20 bg-emerald-500/10 text-emerald-500 rounded-full flex items-center justify-center border border-emerald-500/20\">\n            <CheckCircle2 className=\"w-12 h-12\" />\n          </div>\n        </div>\n        <div className=\"text-center space-y-2\">\n          <h2 className=\"text-2xl font-black uppercase tracking-tight text-white\">Created</h2>\n          <p className=\"text-[10px] text-gray-500 font-bold uppercase tracking-widest\">Awaiting fixed deposit</p>\n        </div>\n\n        <div className=\"p-6 bg-[#0E0E0E] border border-gray-800 rounded-2xl space-y-6\">\n          <div className=\"space-y-2\">\n            <label className=\"text-[10px] font-bold uppercase tracking-widest text-gray-500 block\">Pay-in Address ({fromCoin.toUpperCase()})</label>\n            <div className=\"font-mono text-xs break-all bg-[#1F1F1F] p-4 border border-gray-700 rounded-xl font-bold text-indigo-400\">\n              {txResult.payinAddress}\n            </div>\n          </div>\n          <div className=\"flex justify-between items-center text-xs font-bold uppercase tracking-wider\">\n            <span className=\"text-gray-500\">Amount To Send</span>\n            <span className=\"text-white\">{amount} {fromCoin.toUpperCase()}</span>\n          </div>\n        </div>\n\n        <button \n          onClick={() => setTxResult(null)}\n          className=\"w-full py-5 bg-indigo-600 text-white rounded-2xl text-[10px] font-black uppercase tracking-[0.3em] hover:bg-indigo-500 transition-all active:scale-95 shadow-lg shadow-indigo-600/20\"\n        >\n          New Exchange\n        </button>\n      </motion.div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-xl mx-auto\">\n      <div className=\"bg-[#161616] border border-gray-800 rounded-[2.5rem] p-10 shadow-[0_30px_60px_-12px_rgba(0,0,0,0.5)] space-y-8 relative overflow-hidden\">\n        <div className=\"space-y-6\">\n          <div className=\"space-y-3\">\n            <CurrencySelector \n              label=\"You Send\"\n              currencies={currencies}\n              selectedTicker={fromCoin}\n              onSelect={setFromCoin}\n            />\n            <div className=\"relative group\">\n              <input \n                type=\"number\"\n                value={amount}\n                onChange={(e) => setAmount(e.target.value)}\n                className=\"w-full p-6 text-4xl font-medium bg-[#1F1F1F] border border-gray-700 rounded-2xl focus:border-indigo-500 transition-all outline-none text-white\"\n                placeholder=\"0.00\"\n              />\n              <div className=\"absolute right-6 top-1/2 -translate-y-1/2 text-xs font-black text-gray-500 uppercase tracking-widest bg-[#161616] px-3 py-1 rounded-full border border-gray-700\">\n                {fromCoin}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex justify-center -my-6 relative z-10\">\n            <button \n              onClick={flipCoins}\n              className=\"p-4 bg-indigo-600 text-white rounded-full hover:bg-indigo-500 transition-all duration-300 active:scale-90 shadow-[0_0_20px_rgba(79,70,229,0.4)] border-8 border-[#161616]\"\n            >\n              <ArrowUpDown className=\"w-6 h-6\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            <CurrencySelector \n              label=\"You Receive\"\n              currencies={currencies}\n              selectedTicker={toCoin}\n              onSelect={setToCoin}\n            />\n            <div className=\"relative\">\n              <div className=\"w-full p-6 text-4xl font-medium bg-[#1F1F1F] border border-gray-700 rounded-2xl min-h-[96px] flex items-center text-gray-400\">\n                {estimating ? (\n                  <Loader2 className=\"w-8 h-8 animate-spin text-gray-600\" />\n                ) : (\n                  estimate || \"0.00\"\n                )}\n              </div>\n              <div className=\"absolute right-6 top-1/2 -translate-y-1/2 text-xs font-black text-emerald-500 uppercase tracking-widest bg-[#161616] px-3 py-1 rounded-full border border-gray-700\">\n                {toCoin}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <label className=\"text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 ml-2\">\n              Destination {toCoin.toUpperCase()} Address\n            </label>\n            <input \n              type=\"text\"\n              value={address}\n              onChange={(e) => setAddress(e.target.value)}\n              className=\"w-full p-5 text-sm font-mono border border-gray-700 rounded-2xl focus:border-indigo-500 transition-all outline-none bg-[#1F1F1F] text-gray-200 placeholder:text-gray-600 shadow-inner\"\n              placeholder={`0x... (Recipient Address)`}\n            />\n          </div>\n        </div>\n\n        <AnimatePresence>\n          {error && (\n            <motion.div \n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              className=\"flex items-center gap-3 p-4 bg-red-900/10 text-red-500 rounded-xl text-[10px] font-bold border border-red-500/20\"\n            >\n              <AlertCircle className=\"w-4 h-4 flex-shrink-0\" />\n              {error}\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        <button \n          disabled={loading || !estimate || !user}\n          onClick={handleSwap}\n          className=\"w-full py-6 bg-indigo-600 text-white rounded-2xl font-black text-sm uppercase tracking-[0.3em] disabled:opacity-30 disabled:cursor-not-allowed hover:bg-indigo-500 transition-all active:scale-95 shadow-[0_15px_30px_rgba(79,70,229,0.3)]\"\n        >\n          {loading ? (\n            <Loader2 className=\"w-6 h-6 animate-spin mx-auto text-white/50\" />\n          ) : !user ? (\n            \"Login to Swap\"\n          ) : (\n            \"Exchange Assets\"\n          )}\n        </button>\n\n        {!profile?.isKycVerified && user && (\n          <div className=\"text-[9px] text-center text-amber-500 uppercase tracking-widest font-black py-2 bg-amber-500/5 rounded-full border border-amber-500/10\">\n            KYC Verification Required For This Pair\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
