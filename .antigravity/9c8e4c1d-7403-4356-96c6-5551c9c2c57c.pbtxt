FormData({...formData, documentNumber: e.target.value})}\n              className=\"w-full p-3 border border-black/10 rounded focus:border-black transition-colors outline-none bg-gray-50 text-sm font-bold uppercase\"\n              placeholder=\"X7782190\"\n            />\n          </div>\n        </div>\n\n        <div className=\"p-4 bg-amber-50 border border-amber-200 rounded-lg flex gap-3\">\n          <AlertCircle className=\"w-5 h-5 text-amber-500 flex-shrink-0\" />\n          <p className=\"text-[10px] font-bold text-amber-700 uppercase leading-relaxed tracking-wider\">\n            I certify that the information provided is accurate and belongs to me. I understand that misrepresentation may lead to account suspension.\n          </p>\n        </div>\n\n        <button \n          disabled={loading}\n          type=\"submit\"\n          className=\"w-full py-4 bg-black text-white rounded font-black text-xs uppercase tracking-[0.2em] hover:bg-gray-800 transition-all active:scale-95 flex items-center justify-center gap-2\"\n        >\n          {loading ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : \"Verify Identity\"}\n        </button>\n      </form>\n    </div>\n  );\n};\n"
