    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ChevronDown, Search } from \'lucide-react\';\nimport { ChangellyCurrency } from \'../services/changellyService\';\n\ninterface CurrencySelectorProps {\n  currencies: ChangellyCurrency[];\n  selectedTicker: string;\n  onSelect: (ticker: string) => void;\n  label: string;\n}\n\nexport const CurrencySelector: React.FC<CurrencySelectorProps> = ({ currencies, selectedTicker, onSelect, label }) => {\n  const [isOpen, setIsOpen] = useState(false);\n  const [search, setSearch] = useState(\'\');\n\n  const selected = currencies.find(c => c.ticker === selectedTicker);\n  \n  const filtered = currencies\n    .filter(c => c.enabled)\n    .filter(c => \n      c.ticker.toLowerCase().includes(search.toLowerCase()) || \n      c.fullName.toLowerCase().includes(search.toLowerCase())\n    )\n    .slice(0, 50);\n\n  return (\n    <div className=\"relative\">\n      <label className=\"text-[10px] uppercase tracking-widest font-bold text-gray-400 mb-1 block\">\n        {label}\n      </label>\n      <button \n        onClick={() => setIsOpen(!isOpen)}\n        className=\"w-full flex items-center justify-between p-3 border border-black/10 rounded hover:border-black transition-colors bg-white\"\n      >\n        <div className=\"flex items-center gap-3\">\n          {selected?.image ? (\n            <img src={selected.image} alt={selected.ticker} className=\"w-6 h-6 rounded-full\" />\n          ) : (\n            <div className=\"w-6 h-6 bg-gray-200 rounded-full\" />\n          )}\n          <div className=\"text-left\">\n            <div className=\"text-sm font-black uppercase\">{selectedTicker}</div>\n            <div className=\"text-[10px] text-gray-500 uppercase\">{selected?.fullName}</div>\n          </div>\n        </div>\n        <ChevronDown className={`w-4 h-4 transition-transform ${isOpen ? \'rotate-180\' : \'\'}`} />\n      </button>\n\n      {isOpen && (\n        <div className=\"absolute top-full left-0 right-0 mt-2 bg-white border border-black/10 rounded shadow-2xl z-50 max-h-80 overflow-hidden flex flex-col\">\n          <div className=\"p-2 border-b border-black/5\">\n            <div className=\"relative\">\n              <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400\" />\n              <input \n                autoFocus\n                type=\"text\"\n                placeholder=\"Search coins...\"\n                value={search}\n                onChange={(e) => setSearch(e.target.value)}\n                className=\"w-full pl-9 pr-4 py-2 text-sm bg-gray-50 rounded outline-none\"\n              />\n            </div>\n          </div>\n          <div className=\"overflow-y-auto\">\n            {filtered.map(c => (\n              <button \n                key={c.ticker}\n                onClick={() => {\n                  onSelect(c.ticker);\n                  setIsOpen(false);\n                  setSearch(\'\');\n                }}\n                className=\"w-full flex items-center gap-3 p-3 hover:bg-gray-50 transition-colors border-b border-black/[0.02]\"\n              >\n                <img src={c.image} alt={c.ticker} className=\"w-5 h-5 rounded-full\" />\n                <div className=\"text-left\">\n                  <div className=\"text-xs font-bold uppercase\">{c.ticker}</div>\n                  <div className=\"text-[10px] text-gray-500 uppercase\">{c.fullName}</div>\n                </div>\n              </button>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
