  file_change {
    absolute_path_uri: "file:///src/components/KycForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useAuth } from \'./FirebaseProvider\';\nimport { db } from \'../lib/firebase\';\nimport { doc, updateDoc, serverTimestamp } from \'firebase/firestore\';\nimport { Shield, ChevronRight, CheckCircle2, AlertCircle, Loader2 } from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\nexport const KycForm: React.FC = () => {\n  const { user, profile, refreshProfile } = useAuth();\n  const [loading, setLoading] = useState(false);\n  const [success, setSuccess] = useState(false);\n  const [formData, setFormData] = useState({\n    fullName: profile?.fullName || \'\',\n    dateOfBirth: \'\',\n    documentType: \'Passport\',\n    documentNumber: \'\',\n  });\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!user) return;\n\n    setLoading(true);\n    try {\n      await updateDoc(doc(db, \'users\', user.uid), {\n        ...formData,\n        isKycVerified: true,\n        updatedAt: serverTimestamp(),\n      });\n      await refreshProfile();\n      setSuccess(true);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  if (profile?.isKycVerified || success) {\n    return (\n      <div className=\"max-w-md mx-auto p-12 border border-green-500/20 bg-green-50 rounded-2xl text-center space-y-6\">\n        <div className=\"w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto\">\n          <CheckCircle2 className=\"w-10 h-10\" />\n        </div>\n        <div className=\"space-y-2\">\n          <h2 className=\"text-xl font-black uppercase tracking-tight\">Identity Verified</h2>\n          <p className=\"text-sm text-green-700/70 font-medium\">Your account is now ready for high-volume swaps.</p>\n        </div>\n        <div className=\"p-4 bg-white/50 rounded-lg border border-green-200\">\n          <div className=\"flex justify-between text-[10px] font-bold uppercase tracking-[0.2em] text-green-800/40\">\n            <span>Level</span>\n            <span className=\"text-green-600\">Full Access</span>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-xl mx-auto py-8\">\n      <div className=\"bg-black text-white p-8 rounded-t-2xl space-y-2\">\n        <div className=\"flex items-center gap-2 text-xs font-black uppercase tracking-[0.3em] text-white/50\">\n          <Shield className=\"w-4 h-4\" /> Security Proof\n        </div>\n        <h2 className=\"text-2xl font-black uppercase tracking-tight\">Basic KYC Verification</h2>\n        <p className=\"text-sm text-white/60 font-medium\">Complete this process to unlock full exchange features.</p>\n      </div>\n\n      <form onSubmit={handleSubmit} className=\"p-8 border-x border-b border-black rounded-b-2xl bg-white space-y-6\">\n        <div className=\"grid grid-cols-2 gap-6\">\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-400\">Full Legal Name</label>\n            <input \n              required\n              type=\"text\"\n              value={formData.fullName}\n              onChange={(e) => setFormData({...formData, fullName: e.target.value})}\n              className=\"w-full p-3 border border-black/10 rounded focus:border-black transition-colors outline-none bg-gray-50 text-sm font-bold\"\n              placeholder=\"JONATHAN DOE\"\n            />\n          </div>\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-400\">Date of Birth</label>\n            <input \n              required\n              type=\"date\"\n              value={formData.dateOfBirth}\n              onChange={(e) => setFormData({...formData, dateOfBirth: e.target.value})}\n              className=\"w-full p-3 border border-black/10 rounded focus:border-black transition-colors outline-none bg-gray-50 text-sm font-bold\"\n            />\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-2 gap-6\">\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-400\">Document Type</label>\n            <select \n              value={formData.documentType}\n              onChange={(e) => setFormData({...formData, documentType: e.target.value})}\n              className=\"w-full p-3 border border-black/10 rounded focus:border-black transition-colors outline-none bg-gray-50 text-sm font-bold appearance-none\"\n            >\n              <option value=\"Passport\">PASSPORT</option>\n              <option value=\"ID Card\">ID CARD</option>\n              <option value=\"DL\">DRIVERS LICENSE</option>\n            </select>\n          </div>\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-400\">Document Number</label>\n            <input \n              required\n              type=\"text\"\n              value={formData.documentNumber}\n              onChange={(e) => setFormData({...formData, documentNumber: e.target.value})}\n              className=\"w-full p-3 border border-black/10 rounded focus:border-black transition-colors outline-none bg-gray-50 text-sm font-bold uppercase\"\n              placeholder=\"X7782190\"\n            />\n          </div>\n        </div>\n\n        <div className=\"p-4 bg-amber-50 border border-amber-200 rounded-lg flex gap-3\">\n          <AlertCircle className=\"w-5 h-5 text-amber-500 flex-shrink-0\" />\n          <p className=\"text-[10px] font-bold text-amber-700 uppercase leading-relaxed tracking-wider\">\n            I certify that the information provided is accurate and belongs to me. I understand that misrepresentation may lead to account suspension.\n          </p>\n        </div>\n\n        <button \n          disabled={loading}\n          type=\"submit\"\n          className=\"w-full py-4 bg-black text-white rounded font-black text-xs uppercase tracking-[0.2em] hover:bg-gray-800 transition-all active:scale-95 flex items-center justify-center gap-2\"\n        >\n          {loading ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : \"Verify Identity\"}\n        </button>\n      </form>\n    </div>\n  );\n};\n"
    }
