    replacement_chunks {
      target_content: "export default function App() {\n  return <div></div>;\n}\n"
      replacement_content: "import React, { useState } from \'react\';\nimport { FirebaseProvider, useAuth } from \'./components/FirebaseProvider\';\nimport { Navigation } from \'./components/Navigation\';\nimport { SwapInterface } from \'./components/SwapInterface\';\nimport { TransactionHistory } from \'./components/TransactionHistory\';\nimport { KycForm } from \'./components/KycForm\';\nimport { FavoriteCoins } from \'./components/FavoriteCoins\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { ShieldAlert, LogIn } from \'lucide-react\';\nimport { signInWithGoogle } from \'./lib/firebase\';\n\nfunction MainContent() {\n  const [activeTab, setActiveTab] = useState<\'swap\' | \'history\' | \'kyc\' | \'favorites\'>(\'swap\');\n  const { user, loading } = useAuth();\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center bg-[#F8F8F8]\">\n        <div className=\"w-12 h-12 border-4 border-black border-t-transparent rounded-full animate-spin\" />\n      </div>\n    );\n  }\n\n  if (!user) {\n    return (\n      <div className=\"min-h-screen bg-[#F8F8F8]\">\n        <Navigation activeTab={activeTab} setActiveTab={setActiveTab} />\n        <div className=\"max-w-7xl mx-auto px-4 py-20 flex flex-col items-center text-center space-y-8\">\n          <div className=\"w-20 h-20 bg-black text-white flex items-center justify-center rounded-2xl text-4xl font-black shadow-2xl\">\302\247</div>\n          <div className=\"space-y-2\">\n            <h1 className=\"text-5xl font-black uppercase tracking-tight\">Institutional Grade<br />Crypto Exchange</h1>\n            <p className=\"text-gray-400 font-bold uppercase tracking-widest text-xs\">Secure. Fast. Borderless.</p>\n          </div>\n          \n          <button \n            onClick={signInWithGoogle}\n            className=\"flex items-center gap-3 bg-black text-white px-8 py-4 rounded-xl font-black uppercase tracking-[0.2em] shadow-2xl hover:scale-105 transition-all text-sm active:scale-95\"\n          >\n            <LogIn className=\"w-5 h-5\" /> Start Trading\n          </button>\n\n          <div className=\"grid grid-cols-3 gap-12 pt-20\">\n            <Feature icon={<ShieldAlert />} label=\"Secure Escrow\" />\n            <Feature icon={<ShieldAlert />} label=\"Global Liquidity\" />\n            <Feature icon={<ShieldAlert />} label=\"Instant Delivery\" />\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#F8F8F8] pb-20\">\n      <Navigation activeTab={activeTab} setActiveTab={setActiveTab} />\n      \n      <main className=\"max-w-7xl mx-auto px-4 pt-12\">\n        <AnimatePresence mode=\"wait\">\n          <motion.div\n            key={activeTab}\n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            transition={{ duration: 0.2 }}\n          >\n            {activeTab === \'swap\' && <SwapInterface />}\n            {activeTab === \'history\' && <TransactionHistory />}\n            {activeTab === \'kyc\' && <KycForm />}\n            {activeTab === \'favorites\' && <FavoriteCoins />}\n          </motion.div>\n        </AnimatePresence>\n      </main>\n    </div>\n  );\n}\n\nconst Feature = ({ icon, label }: { icon: React.ReactNode; label: string }) => (\n  <div className=\"flex flex-col items-center gap-2\">\n    <div className=\"text-black/20\">{icon}</div>\n    <span className=\"text-[10px] font-black uppercase tracking-widest text-gray-400\">{label}</span>\n  </div>\n);\n\nexport default function App() {\n  return (\n    <FirebaseProvider>\n      <MainContent />\n    </FirebaseProvider>\n  );\n}\n"
    }
